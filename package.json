{
  "name": "portefolje",
  "type": "module",
  "version": "0.1.0",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "cspell": "^10.4.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "vite": "^8.3.6"
  },
  "private": true,
  "scripts": {
    "dev": "vite",
    "format": "prettier --write .",
    "spell": "cspell lint . --cache",
    "build": "vite build",
    "deploy": "gh-pages -d dist",
    "check": "vite build && cspell lint . --cache && prettier --check ."
  }
}
