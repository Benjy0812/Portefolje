{
  "name": "nordisk-vaer",
  "type": "module",
  "version": "0.1.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "cspell": "^10.4.0",
    "eslint": "^10.13.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "vite": "^8.3.5"
  },
  "private": true,
  "scripts": {
    "dev": "vite",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint",
    "spell": "cspell lint . --cache",
    "build": "vite build",
    "deploy": "gh-pages -d dist",
    "check": "vite build && bun test && eslint && cspell lint . --cache && prettier --check ."
  }
}